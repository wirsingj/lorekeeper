{
  "name": "lorekeeper",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first tabletop RPG campaign memory engine and AI desktop app.",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "node ./src/index.js",
    "demo": "node ./src/index.js",
    "test": "npm run test:all",
    "test:engine": "node ./scripts/test-engine-architecture.js",
    "test:contract": "node ./scripts/test-json-contract.js",
    "test:multiplayer": "node ./scripts/test-multiplayer.js",
    "test:storage": "node ./scripts/test-sqlite-storage.js",
    "test:security": "node ./scripts/test-server-security.js && node ./scripts/test-server-integration.js",
    "test:regression": "node ./scripts/test-high-risk-regressions.js",
    "test:all": "npm run test:engine && npm run test:contract && npm run test:multiplayer && npm run test:storage && npm run test:security && npm run test:regression",
    "new:campaign": "node ./scripts/new-campaign.js",
    "import:folder": "node ./scripts/import-campaign-folder.js",
    "api": "node ./scripts/serve.js 4174",
    "dev": "node ./scripts/dev.js",
    "vite": "vite --host 127.0.0.1",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "client": "node ./scripts/launch-desktop.js --client",
    "package:join": "npm run build && node ./scripts/package-join-client.js",
    "package:thin": "npm run package:join",
    "cleanup": "node ./scripts/cleanup-processes.js",
    "shortcut": "cscript //nologo \"Create LoreKeeper Desktop Shortcut.vbs\""
  },
  "keywords": [
    "campaign",
    "rpg",
    "browser-extension",
    "local-first"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sql.js": "^1.14.1",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "electron": "^42.4.0"
  }
}
