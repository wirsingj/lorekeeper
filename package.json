{
  "name": "lorekeeper",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first tabletop RPG campaign memory engine and AI desktop app.",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "node ./src/index.js",
    "demo": "node ./src/index.js",
    "test": "node ./scripts/test-engine-architecture.js && node ./scripts/test-json-contract.js && node ./scripts/test-multiplayer.js && node ./scripts/test-sqlite-storage.js",
    "new:campaign": "node ./scripts/new-campaign.js",
    "import:folder": "node ./scripts/import-campaign-folder.js",
    "api": "node ./scripts/serve.js 4174",
    "dev": "node ./scripts/dev.js",
    "vite": "vite --host 127.0.0.1",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "client": "node ./scripts/launch-desktop.js --client",
    "cleanup": "node ./scripts/cleanup-processes.js",
    "shortcut": "cscript //nologo \"Create LoreKeeper Desktop Shortcut.vbs\""
  },
  "keywords": [
    "campaign",
    "rpg",
    "browser-extension",
    "local-first"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sql.js": "^1.14.1",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "electron": "^42.4.0"
  }
}
